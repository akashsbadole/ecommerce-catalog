generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ─── Platform Models ───────────────────────────────────────────

model Store {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique // used as subdomain: {slug}.wcommerce.com
  domain        String?  @unique // custom domain: shop.example.com
  logo          String?
  favicon       String?
  description   String?
  theme         String   @default("{}") // JSON: colors, fonts, layout
  plan          String   @default("free") // free, basic, pro, enterprise
  isActive      Boolean  @default(true)
  isPaused      Boolean  @default(false)
  ownerUserId   String
  settings      String   @default("{}") // JSON: per-store config (currency, tax_rate, etc.)
  whatsappNumber String?  // store WhatsApp number for catalogue sharing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Owner        User    @relation("StoreOwner", fields: [ownerUserId], references: [id])
  CurrentUsers   User[]   @relation("CurrentUserStore")
  Product       Product[]
  Category      Category[]
  Order         Order[]
  Coupon        Coupon[]
  Quote         Quote[]
  BlogPost      BlogPost[]
  Banner        Banner[]
  ContentPage   ContentPage[]
  Enquiry       Enquiry[]
  Media         Media[]
  Redirect      Redirect[]
  Warehouse     Warehouse[]
  Invoice       Invoice[]
  ProductBundle  ProductBundle[]
  Return         Return[]
  CustomerGroup  CustomerGroup[]
  PincodeService PincodeService[]
  LowStockAlert  LowStockAlert[]
  EmailCampaign  EmailCampaign[]

  @@index([ownerUserId])
  @@index([isActive])
}

// ─── User & Auth ───────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
}

// ─── Catalog ───────────────────────────────────────────────────

model Product {
  id                String           @id @default(cuid())
  storeId           String?          // tenant isolation
  name              String
  slug              String           @unique
  description       String?
  shortDescription  String?
  price             Float
  comparePrice      Float?
  wholesalePrice    Float?
  minOrderQty       Int              @default(1)
  sku               String?
  images            String           @default("[]")
  categoryId        String?
  whatsappNumber    String?
  isFeatured        Boolean          @default(false)
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  specifications    String?
  metaTitle         String?
  metaDescription   String?
  customSchema      String?          @default("{}")
  deletedAt         DateTime?
  stock             Int              @default(0)
  lowStockThreshold Int              @default(10)
  relatedProductIds String           @default("[]")
  documents         String           @default("[]")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now())
  Enquiry           Enquiry[]
  Category          Category?        @relation(fields: [categoryId], references: [id])
  Store             Store?           @relation(fields: [storeId], references: [id])
  ProductVariant    ProductVariant[]
  ProductTier       ProductTier[]
  CartItem          CartItem[]
  WishlistItem      WishlistItem[]
  OrderItem         OrderItem[]
  CustomPrice       CustomPrice[]
  Subscription      Subscription[]
  Inventory         Inventory[]
  BundleItems       ProductBundleItem[]
  Visibility        ProductVisibility[]
  LowStockAlert     LowStockAlert[]

  @@index([deletedAt])
  @@index([storeId])
}

model Category {
  id              String    @id @default(cuid())
  storeId         String?   // tenant isolation
  name            String
  slug            String    @unique
  description     String?
  image           String?
  parentId        String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  blocks          String    @default("[]")
  customSchema    String?   @default("{}")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  Product         Product[]
  Store           Store?    @relation(fields: [storeId], references: [id])
  parent          Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")

  @@index([deletedAt])
  @@index([storeId])
}

model ProductTier {
  id        String   @id @default(cuid())
  productId String
  tierName  String
  minQty    Int
  price     Float
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String?
  price          Float?
  comparePrice   Float?
  wholesalePrice Float?
  stock          Int      @default(0)
  images         String   @default("[]")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  Product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Orders ────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  storeId        String?     // tenant isolation
  userId         String?
  orderNumber    String      @unique
  status         String      @default("pending")
  paymentStatus  String      @default("pending")
  paymentMethod  String?
  subtotal       Float
  shippingCost   Float       @default(0)
  tax            Float       @default(0)
  total          Float
  currency       String      @default("INR")
  shippingName   String?
  shippingEmail  String?
  shippingPhone  String?
  shippingAddress String?
  shippingPincode String?
  shippingCity   String?
  shippingState  String?
  billingName    String?
  billingEmail   String?
  billingAddress String?
  notes          String?
  trackingNumber String?
  warehouseId    String?
  invoiceNumber  String?
  gstNumber      String?
  approvalStatus String?     @default("none") // none, pending, approved, rejected
  approvalNotes  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  User           User?       @relation(fields: [userId], references: [id])
  Store          Store?      @relation(fields: [storeId], references: [id])
  Warehouse      Warehouse?  @relation(fields: [warehouseId], references: [id])
  items          OrderItem[]
  Invoices       Invoice[]
  Return         Return[]
  OrderApproval  OrderApproval[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([storeId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  sku         String?
  price       Float
  quantity    Int
  total       Float
  images      String   @default("[]")
  Order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Cart & Wishlist ───────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  recoveryEmailSent Boolean @default(false)
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  createdAt DateTime       @default(now())
  User      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@unique([userId])
}

model WishlistItem {
  id          String    @id @default(cuid())
  wishlistId  String
  productId   String
  createdAt   DateTime  @default(now())
  Wishlist    Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  Product     Product   @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

// ─── Discounts ─────────────────────────────────────────────────

model Coupon {
  id        String    @id @default(cuid())
  storeId   String?   // tenant isolation
  code      String
  type      String
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  Store     Store?    @relation(fields: [storeId], references: [id])

  @@unique([code])
  @@index([storeId])
}

// ─── Content / CMS ─────────────────────────────────────────────

model BlogPost {
  id              String    @id @default(cuid())
  storeId         String?   // tenant isolation
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @default("")
  coverImage      String?
  authorId        String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  blocks          String    @default("[]")
  tags            String?
  customSchema    String?   @default("{}")
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  deletedAt       DateTime?
  User            User?     @relation(fields: [authorId], references: [id])
  Store           Store?    @relation(fields: [storeId], references: [id])

  @@index([deletedAt])
  @@index([storeId])
}

model ContentPage {
  id              String   @id @default(cuid())
  storeId         String?  // tenant isolation
  title           String
  slug            String   @unique
  content         String   @default("")
  blocks          String   @default("[]")
  heroImage       String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  customSchema    String?  @default("{}")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  Store           Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Banner {
  id        String   @id @default(cuid())
  storeId   String?  // tenant isolation
  title     String
  subtitle  String?
  image     String?
  link      String?
  linkText  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Store     Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// ─── Media ─────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  storeId      String?  // tenant isolation
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  url          String
  thumbnails   String   @default("{}")
  folder       String   @default("/")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  Store        Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// ─── Enquiries ─────────────────────────────────────────────────

model Enquiry {
  id             String   @id @default(cuid())
  storeId        String?  // tenant isolation
  name           String
  email          String
  phone          String?
  companyName    String?
  companyEmail   String?
  companyPhone   String?
  companyAddress String?
  quantity       Int?
  subject        String
  message        String
  productId      String?
  type           String   @default("product")
  status         String   @default("new")
  userId         String?
  companyId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  Product        Product? @relation(fields: [productId], references: [id])
  User           User?    @relation(fields: [userId], references: [id])
  Company        Company? @relation(fields: [companyId], references: [id])
  Store          Store?   @relation(fields: [storeId], references: [id])
  Quote          Quote?

  @@index([storeId])
}

// ─── Redirects ─────────────────────────────────────────────────

model Redirect {
  id        String   @id @default(cuid())
  storeId   String?  // tenant isolation
  from      String   @unique
  to        String
  type      String   @default("301")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Store     Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// ─── Settings ──────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  storeId   String?  // null = global platform setting, non-null = store-specific
  key       String
  value     String
  updatedAt DateTime @default(now())

  @@unique([storeId, key])
  @@index([storeId])
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  name                    String
  password                String
  role                    String               @default("clerk")
  isActive                Boolean              @default(true)
  companyId               String?
  isVerified              Boolean              @default(false)
  tier                    String               @default("standard")
  documents               String               @default("[]")
  addresses               String               @default("[]")
  phone                   String?
  avatar                  String?
  currentStoreId          String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now())
  ActivityLog             ActivityLog[]
  BlogPost                BlogPost[]
  Enquiry                 Enquiry[]
  PasswordResetToken      PasswordResetToken[]
  EmailVerificationToken  EmailVerificationToken[]
  Company                 Company?             @relation(fields: [companyId], references: [id])
  Quote                   Quote[]
  Store                   Store?               @relation("CurrentUserStore", fields: [currentStoreId], references: [id])
  OwnedStores             Store[]              @relation("StoreOwner")
  Order                   Order[]
  Cart                    Cart?
  Wishlist                Wishlist?
  Subscription            Subscription[]
  Invoice                 Invoice[]
  Return                  Return[]
  OrderApproval           OrderApproval[]
  CustomerGroupMember     CustomerGroupMember[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  userName  String?
  ipAddress String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  userId    String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Company {
  id          String    @id @default(cuid())
  name        String
  taxId       String?
  address     String?
  website     String?
  isVerified  Boolean   @default(false)
  tier        String    @default("standard")
  discountRate Float?
  gstNumber   String?
  creditTerms  String?  @default("prepaid") // prepaid, net-15, net-30, net-60, net-90
  creditLimit  Float    @default(0)
  creditUsed   Float    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  User        User[]
  Enquiry     Enquiry[]
  Quote       Quote[]
  CustomPrice CustomPrice[]
  Subscription Subscription[]
  Invoice      Invoice[]
  CustomerGroupMember CustomerGroupMember[]
}

model Quote {
  id            String    @id @default(cuid())
  storeId       String?
  enquiryId     String?   @unique
  companyId     String?
  userId        String
  quoteNumber   String    @unique
  items         String    @default("[]")
  totalAmount   Float
  subtotal      Float     @default(0)
  discount      Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  currency      String    @default("INR")
  status        String    @default("draft")
  validUntil    DateTime?
  notes         String?
  adminNotes    String?
  recoveryEmailSent Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  Enquiry       Enquiry?  @relation(fields: [enquiryId], references: [id])
  Company       Company?  @relation(fields: [companyId], references: [id])
  User          User      @relation(fields: [userId], references: [id])
  Store         Store?    @relation(fields: [storeId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([quoteNumber])
  @@index([storeId])
}

// ─── Extended B2B & Warehousing ────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  storeId   String?
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Store     Store?   @relation(fields: [storeId], references: [id])
  Inventory Inventory[]
  Order     Order[]

  @@index([storeId])
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  variantId   String?
  warehouseId String
  stock       Int       @default(0)
  updatedAt   DateTime  @default(now())
  Product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  Warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, warehouseId])
}

model CustomPrice {
  id        String   @id @default(cuid())
  companyId String
  productId String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  companyId        String?
  productId        String
  quantity         Int
  frequency        String    @default("monthly")
  nextDeliveryDate DateTime
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  User             User      @relation(fields: [userId], references: [id])
  Company          Company?  @relation(fields: [companyId], references: [id])
  Product          Product   @relation(fields: [productId], references: [id])

  @@index([userId])
}

model Invoice {
  id              String       @id @default(cuid())
  storeId         String?
  orderId         String?
  userId          String?
  companyId       String?
  invoiceNumber   String       @unique
  status          String       @default("draft")
  subtotal        Float
  shippingCost    Float        @default(0)
  discount        Float        @default(0)
  tax             Float        @default(0)
  taxRate         Float        @default(0)
  total           Float
  currency        String       @default("INR")
  gstNumber       String?
  gstType         String?
  notes           String?
  billingName     String?
  billingEmail    String?
  billingAddress  String?
  companyName     String?
  companyAddress  String?
  companyTaxId    String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  Order           Order?       @relation(fields: [orderId], references: [id])
  User            User?        @relation(fields: [userId], references: [id])
  Company         Company?     @relation(fields: [companyId], references: [id])
  Store           Store?       @relation(fields: [storeId], references: [id])
  items           InvoiceItem[]

  @@index([storeId])
  @@index([orderId])
  @@index([userId])
  @@index([companyId])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  productId String?
  name      String
  sku       String?
  hsnCode   String?
  price     Float
  quantity  Int
  total     Float
  gstRate   Float    @default(0)
  gstAmount Float    @default(0)
  Invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Cross-sell / Bundles ──────────────────────────────────────

model ProductBundle {
  id             String   @id @default(cuid())
  storeId        String?
  name           String
  slug           String   @unique
  description    String?
  discountPercent Float   @default(0)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Store          Store?   @relation(fields: [storeId], references: [id])
  items          ProductBundleItem[]

  @@index([storeId])
}

model ProductBundleItem {
  id        String       @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int          @default(1)
  Bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  Product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
}

// ─── Returns / RMA ─────────────────────────────────────────────

model Return {
  id           String   @id @default(cuid())
  storeId      String?
  orderId      String
  userId       String
  returnNumber String   @unique
  status       String   @default("requested") // requested, approved, picked_up, received, refunded, rejected
  reason       String
  reasonDetail String?
  items        String   @default("[]") // JSON: [{orderItemId, quantity, reason}]
  total        Float    @default(0)
  refundMethod String?  // original_payment, store_credit, bank_transfer
  refundAmount Float    @default(0)
  notes        String?
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Order        Order    @relation(fields: [orderId], references: [id])
  User         User     @relation(fields: [userId], references: [id])
  Store        Store?   @relation(fields: [storeId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([storeId])
}

// ─── Order Approval Workflows ──────────────────────────────────

model OrderApproval {
  id          String   @id @default(cuid())
  orderId     String
  approverId  String?
  status      String   @default("pending") // pending, approved, rejected
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User        User?    @relation(fields: [approverId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ─── OTP Login ─────────────────────────────────────────────────

model OTP {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  otp       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([expiresAt])
}

// ─── Customer Groups (product visibility) ──────────────────────

model CustomerGroup {
  id          String   @id @default(cuid())
  storeId     String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Store       Store?   @relation(fields: [storeId], references: [id])
  members     CustomerGroupMember[]
  products    ProductVisibility[]

  @@index([storeId])
}

model CustomerGroupMember {
  id       String        @id @default(cuid())
  groupId  String
  userId   String?
  companyId String?
  Group    CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User     User?         @relation(fields: [userId], references: [id])
  Company  Company?      @relation(fields: [companyId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
}

model ProductVisibility {
  id        String        @id @default(cuid())
  productId String
  groupId   String
  isVisible Boolean       @default(true)
  Product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  Group     CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([productId])
  @@index([groupId])
}

// ─── Low Stock Alerts ──────────────────────────────────────────

model LowStockAlert {
  id             String   @id @default(cuid())
  storeId        String?
  productId      String
  threshold      Int      @default(10)
  lastAlertedAt  DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  Store          Store?   @relation(fields: [storeId], references: [id])
  Product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
}

// ─── Email Marketing Automation ────────────────────────────────

model EmailCampaign {
  id           String   @id @default(cuid())
  storeId      String?
  name         String
  subject      String
  content      String   // HTML content
  type         String   @default("manual") // manual, automated
  triggerType  String?  // abandoned_cart, order_confirmation, welcome, custom
  status       String   @default("draft") // draft, scheduled, sending, sent, failed
  scheduledAt  DateTime?
  sentAt       DateTime?
  recipientCount Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Store        Store?   @relation(fields: [storeId], references: [id])
  logs         EmailCampaignLog[]

  @@index([storeId])
  @@index([status])
}

model EmailCampaignLog {
  id         String        @id @default(cuid())
  campaignId String
  email      String
  userId     String?
  sentAt     DateTime      @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  Campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
}

// ─── Pincode Serviceability ────────────────────────────────────

model PincodeService {
  id           String   @id @default(cuid())
  storeId      String?
  pincode      String
  isServiceable Boolean @default(true)
  deliveryDays Int      @default(5)
  shippingCost Float    @default(0)
  codAvailable Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  Store        Store?   @relation(fields: [storeId], references: [id])

  @@unique([storeId, pincode])
  @@index([storeId])
  @@index([pincode])
}
